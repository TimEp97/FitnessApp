    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
