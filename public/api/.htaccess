# Konfiguration, Bibliothek und Daten nie direkt ausliefern
<FilesMatch "^(config(\.example)?\.php|_lib\.php|.*\.json|.*\.sqlite|.*\.log|\.lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
